    {
     "name": "Cancel a request",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// The three reasons mean different things to a trader, so branch on them",
         "// rather than showing one generic refusal.",
         "if (pm.response.code === 409) {",
         "    const reason = pm.response.json().details.reason;",
         "    pm.test('the reason is one of the three', () =>",
         "        pm.expect(['ALREADY_INSTRUCTED', 'ALREADY_TERMINAL', 'NOT_FOUND']).to.include(reason));",
         "    console.log('not cancellable:', reason);",
         "}"
        ]
       }
      }
     ],
     "request": {
      "method": "DELETE",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/v1/funds/payout/{{requestId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "funds",
        "payout",
        "{{requestId}}"
       ]
      },
      "description": "Permitted while ACCEPTED or QUEUED_FOR_RUN. It stays available after a rail outage has deferred the request, since a trader whose payout was deferred has more reason to want it stopped.\n\nA request belonging to another trader answers 409 with reason NOT_FOUND rather than 403 — confirming existence would itself leak."
     },
