        "exec": [
         "// 204 is an ordinary state, not an error. Parsing before checking the status",
         "// throws on an empty body.",
         "pm.test('204 carries no body', () => {",
         "    if (pm.response.code === 204) {",
         "        pm.expect(pm.response.text()).to.be.empty;",
         "    }",
         "});",
         "if (pm.response.code === 200) {",
         "    pm.collectionVariables.set('requestId', String(pm.response.json().requestId));",
