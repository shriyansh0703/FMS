  {
   "name": "Adding funds",
   "description": "Route limits, measured against what has already gone out today.",
   "item": [
    {
     "name": "Remaining headroom today",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// A null cap means unbounded. Rendering it as zero tells a trader NEFT is",
         "// exhausted when it has no limit at all.",
         "const routes = pm.response.json().routes;",
         "pm.test('an uncapped route sends null, not zero', () => {",
         "    routes.filter(r => r.remainingToday === null)",
         "          .forEach(r => pm.expect(r.remainingToday).to.be.null);",
         "});",
         "routes.forEach(r => console.log(r.route,",
         "    r.remainingToday === null ? 'uncapped' : r.remainingToday.paise + ' paise'));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/v1/funds/payin/limits",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "funds",
        "payin",
        "limits"
       ]
      },
      "description": "The cap is daily and is measured against everything already sent on that route today, not per transaction. Two transfers of the cap amount will not both pass.\n\nA route with no cap returns `remainingToday: null`. That means unbounded and must not be rendered as zero.\n\nRender limits from these figures rather than naming them in copy: a message naming ₹1,00,000 becomes wrong the day Payments changes the value."
     },
     "response": [
      {
       "name": "200 OK",
       "originalRequest": {
        "method": "GET",
        "header": [],
        "url": {
         "raw": "{{baseUrl}}/api/v1/funds/payin/limits",
